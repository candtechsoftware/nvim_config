{
  "name": "ai-anno",
  "displayName": "ai-anno",
  "description": "Visualize line-anchored .anno.json annotations inline: gutter marks, end-of-line summaries, and hovers.",
  "version": "0.1.0",
  "publisher": "candtechsoftware",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "annotations",
    "code review",
    "comments"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node test/run.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "aiAnno.toggle",
        "title": "Toggle Annotations",
        "category": "ai-anno",
        "icon": "$(eye)"
      },
      {
        "command": "aiAnno.reload",
        "title": "Reload Annotations",
        "category": "ai-anno",
        "icon": "$(refresh)"
      },
      {
        "command": "aiAnno.next",
        "title": "Go to Next Annotation",
        "category": "ai-anno"
      },
      {
        "command": "aiAnno.prev",
        "title": "Go to Previous Annotation",
        "category": "ai-anno"
      },
      {
        "command": "aiAnno.list",
        "title": "List All Annotations",
        "category": "ai-anno",
        "icon": "$(search)"
      }
    ],
    "configuration": {
      "title": "ai-anno",
      "properties": {
        "aiAnno.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render annotations in the editor. Toggle at runtime with \"ai-anno: Toggle Annotations\"."
        }
      }
    },
    "colors": [
      {
        "id": "aiAnno.why",
        "description": "Color for \"why\" annotations.",
        "defaults": {
          "dark": "#5aa9f8",
          "light": "#0b62c4",
          "highContrast": "#7cc0ff"
        }
      },
      {
        "id": "aiAnno.explain",
        "description": "Color for \"explain\" annotations.",
        "defaults": {
          "dark": "#b184f0",
          "light": "#6b32c9",
          "highContrast": "#c9a6ff"
        }
      },
      {
        "id": "aiAnno.warning",
        "description": "Color for \"warning\" annotations.",
        "defaults": {
          "dark": "#e0c168",
          "light": "#8a6a00",
          "highContrast": "#ffd873"
        }
      },
      {
        "id": "aiAnno.review",
        "description": "Color for \"review\" annotations.",
        "defaults": {
          "dark": "#ef9a4a",
          "light": "#a4530a",
          "highContrast": "#ffb066"
        }
      },
      {
        "id": "aiAnno.todo",
        "description": "Color for \"todo\" annotations.",
        "defaults": {
          "dark": "#6fbf73",
          "light": "#1f7a2e",
          "highContrast": "#8ede92"
        }
      },
      {
        "id": "aiAnno.stale",
        "description": "Color for stale annotations whose snippet no longer matches.",
        "defaults": {
          "dark": "#7f8590",
          "light": "#767676",
          "highContrast": "#9aa0aa"
        }
      }
    ]
  }
}
